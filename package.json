{
  "name": "nuwax-openui-mcp-workspace",
  "private": true,
  "version": "0.3.8",
  "description": "Nuwax OpenUI MCP workspace (server + frozen renderer runtime).",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuwax-ai/nuwax-openui-mcp.git"
  },
  "scripts": {
    "build": "pnpm clean && pnpm build:server && pnpm build:runtime",
    "build:server": "pnpm gen:openui && tsc -p packages/server/tsconfig.json && node packages/server/scripts/copy-openui-artifacts.mjs",
    "build:runtime": "pnpm --filter @nuwax-ai/openui-runtime build",
    "clean": "node -e \"require('node:fs').rmSync('packages/server/dist', { recursive: true, force: true })\"",
    "dev:stdio": "tsx packages/server/src/stdio.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:openui": "node packages/server/scripts/gen-openui-artifacts.mjs",
    "lint": "eslint .",
    "start": "node packages/server/dist/server/stdio.js",
    "test": "pnpm gen:openui && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/server/tsconfig.json --noEmit && pnpm --filter @nuwax-ai/openui-runtime typecheck",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepublishOnly": "echo 'Publish with: pnpm publish --filter @nuwax-ai/openui-mcp && pnpm publish --filter @nuwax-ai/openui-runtime' && exit 1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@openuidev/react-ui": "0.13.2",
    "@types/node": "24.10.1",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "prettier": "3.7.4",
    "react-dom": "18.3.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vitest": "4.0.15",
    "zustand": "4.5.7"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.30.3"
}
