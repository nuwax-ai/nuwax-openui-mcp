# Optional fallback when the MCP host cannot expose roots or start the server
# with the active project as its working directory.
NUWAX_OPENUI_PROJECT_ROOT=/absolute/path/to/project

# Opt-in: append package version to MCP tool names (e.g. nuwax_render_openui_v0_3_12).
# Default is off — tools use stable base names (nuwax_render_openui, …).
# Truthy values: 1 / true / yes / on (case-insensitive).
# NUWAX_OPENUI_TOOL_VERSION_SUFFIX=1
